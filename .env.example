# Environment Variables
TELEGRAM_TOKEN=your_telegram_bot_token_here

# LiteLLM model selection (provider-prefixed). Override to switch providers:
#   groq/llama-3.3-70b-versatile  |  openai/gpt-4o-mini  |  gemini/gemini-2.5-flash
# Defaults to groq/llama-3.3-70b-versatile if unset.
LLM_MODEL=groq/llama-3.3-70b-versatile

# Provider API key — set the one matching your LLM_MODEL above.
# LiteLLM reads the matching variable automatically.
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
